# Admin runs locally only — not deployed on DC Deploy (see admin/README.md).
#
# Leave VITE_API_BASE_URL unset in dev. The Vite dev server proxies /api and /uploads
# to ADMIN_DEV_API_PROXY_TARGET so browser requests stay same-origin (no CORS changes).

# Default: edit production CMS content via the live API
ADMIN_DEV_API_PROXY_TARGET=https://api.commiters.com
VITE_SITE_URL=https://www.commiters.com
VITE_PUBLIC_SITE_URL=https://www.commiters.com

# Optional: full local stack (also start backend on :4000)
# ADMIN_DEV_API_PROXY_TARGET=http://localhost:4000
# VITE_SITE_URL=http://localhost:5173
# VITE_PUBLIC_SITE_URL=http://localhost:5173
