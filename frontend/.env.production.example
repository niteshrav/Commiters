# Static marketing site (no backend / admin yet)
# Leave API and admin unset — production builds will not call localhost.

# Form inbox (Contact + Join Us) — fixed in code as hello@commiters.com
VITE_OWNER_EMAIL=hello@commiters.com

# When you deploy API + admin later, set:
# VITE_API_BASE_URL=https://api.example.com
# VITE_ADMIN_URL=https://admin.example.com

# Optional: disable backend during local dev (uses static fallbacks only)
# VITE_ENABLE_BACKEND=false
